{
  "name": "planiar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite\" \"tsx server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx server/dev.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/database/migrate.ts",
    "preview": "vite preview"
  },
