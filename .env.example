# Origem pública do aplicativo. Em produção, use a URL HTTPS da Vercel.
APP_ORIGIN=http://localhost:5174

# PostgreSQL gerenciado (Neon ou Supabase). Sem esta variável, o desenvolvimento
# local usa um PGlite em .data/pglite. Na Vercel, a API responde 503 até ela existir.
DATABASE_URL=postgres://usuario:senha@host/planiar?sslmode=require

# Chave de 32 bytes em base64 para criptografar imagens armazenadas no Postgres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em desenvolvimento, se ficar vazia, uma chave local é criada em .data/dev-encryption-key.
APP_ENCRYPTION_KEY=

# Resend. Sem estas variáveis, a recuperação de senha não envia e-mail.
# Em desenvolvimento, a API informa isso explicitamente e pode devolver o link local.
RESEND_API_KEY=
EMAIL_FROM=Planiar <noreply@seudominio.com>

# Vercel Blob. Sem o token, as fotos ficam criptografadas na tabela media_objects.
BLOB_READ_WRITE_TOKEN=

# Ably. Sem a chave, os clientes usam sincronização ao reconectar, ao voltar
# para a aba e a cada 15 segundos. Não há WebSocket dentro da função da Vercel.
ABLY_API_KEY=

# Porta da API local.
PORT=8787
